# Copy this file to .env.local for local development and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Kit (formerly ConvertKit) API v4 secret key. Server-side only — read via
# process.env.KIT_API_KEY inside /api/subscribe.js. Never expose this to the
# browser or commit it. Find/create yours at https://app.kit.com/account_settings/developer_settings
KIT_API_KEY=

# Optional. Numeric Kit Tag ID to apply to every subscriber who signs up
# through this website (e.g. a "Website Signup" tag), so they're
# identifiable as coming from seanbobbykerr.com. Leave blank to skip tagging
# — subscriber creation works fine without it. Find the ID in Kit under
# Grow > Tags (it's in the tag's URL: app.kit.com/subscribers/tags/<ID>).
KIT_TAG_ID=
